class Solution {
    public int[] twoSum(int[] nums, int target) {
        int end = nums.length;
        int[] arr = new int[2];
        for(int i=0;i<end;i++){
            for(int j = i+1;j<end;j++){
                if(nums[i]+nums[j]==target){
                    arr[0]=i;
                    arr[1]=j;
                    return arr;
                }
            }
       }
        return arr;
    }
}
