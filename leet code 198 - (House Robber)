class Solution {
    public int rob(int[] nums) {
        int prev2 = 0;
        int prev1 = 0;

        for (int i = 0; i < nums.length; i++) {
            int a = prev2 + nums[i];
            int b = prev1;

            int current = Math.max(a, b);

            prev2 = prev1;
            prev1 = current;
        }

        return prev1;
    }
}
