class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        
        int[] fi = new int[nums1.length + nums2.length];

        int k = 0;

        for (int i = 0; i < nums1.length; i++) {
            fi[k] = nums1[i];
            k++;
        }

        for (int i = 0; i < nums2.length; i++) {
            fi[k] = nums2[i];
            k++;
        }

        Arrays.sort(fi);

        if (fi.length % 2 == 0) {
            return (fi[fi.length / 2 - 1] + fi[fi.length / 2]) / 2.0;
        } else {
            return fi[fi.length / 2];
        }
    }
}
