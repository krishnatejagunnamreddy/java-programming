class Solution {
    public long minimumTime(int[] time, int totalTrips) {
        int min = time[0];
        for(int i = 0;i<time.length;i++){
            if(min<time[i]) min = time[i];
        }
        
        int max = min*totalTrips;
        int ans=max;
        while(min<=max){
            int mid = min -(min-max)/2;
            int trip =0;
            for(int i = 0;i<time.length;i++){
                trip += mid/time[i];
            }
            if(trip>=totalTrips){
                max = mid-1;
                if(ans>mid) ans = mid;
            }
            else {
                min =  mid+1;
            }
            
        }
        return ans;
    }
}
