class Solution {
    public int maximum69Number(int num) {
        if(num/1000==6) num = 9*1000+(num%1000);
        else if(num/100%10==6) num = (num/1000)*1000+9*100+(num%100);
        else if(num/10%10==6) num = (num/100)*100+9*10+(num%10);
        else if(num%10==6) num = (num/10)*10+9;
        return num;
    }
}
