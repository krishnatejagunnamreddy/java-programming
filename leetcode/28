class Solution {
    public int strStr(String haystack, String needle) {
        int l1 = haystack.length() , l2 = needle.length();
        for(int i = 0;i<=(l1-l2);i++){
            String str = "";
            for(int j =0;j<l2;j++){
                str += haystack.charAt(i+j);
            }
            if(needle.equals(str)) return i;
        }
        return -1;
    }
}
