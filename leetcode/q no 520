class Solution {
    public boolean detectCapitalUse(String word) {
        int scount=0,ucount=0;
        for(int i=0;i<word.length();i++){
            if(word.charAt(i)>=97&&word.charAt(i)<=122){
                scount++;
            }
            else ucount++;
        }  
        if(ucount==word.length()||scount==word.length()) return true;
        else if((word.charAt(0)>=65&&word.charAt(0)<=90)&&scount==word.length()-1) return true;
        return false;
    }
}
