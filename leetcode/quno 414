class Solution {
    public int thirdMax(int[] nums) {
        int max = Integer.MIN_VALUE,smax = Integer.MIN_VALUE , tmax = Integer.MIN_VALUE;
         for(int i = 0;i<nums.length;i++ ){
            if(max<nums[i]){
                tmax = smax ;
                smax = max;
                max = nums[i];
            }
            else if(smax<nums[i]&&max!=nums[i]){
                tmax = smax;
                smax = nums[i];
            }
            else if(tmax<nums[i]&&smax!=nums[i]&&max!=nums[i]){
                tmax = nums[i];
            }
         }
         if(nums.length==2||tmax == Integer.MIN_VALUE) return max;
         return tmax;
    }
}
