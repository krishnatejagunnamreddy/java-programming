class Solution {
    public boolean isHappy(int n) {
        int b=0;
        if(n==1){
            return true;
        }
        else if((n>1&&n<10)||n==0){
            if(n==7){
                return true;
            }
            else{
                return false;
            }
        }
        else{
            while(n!=0){
                int r=n%10;
                b=b+ r*r;
                n/=10;
            }
            
            return isHappy( b) ;
        }
        
    }
}
